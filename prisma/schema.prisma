// Schema do PatotApp.
// Ciclo 1: usuários, autenticação (modelos exigidos pelo Auth.js) e perfil do jogador.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Posições usadas no sorteio de times (RF25).
enum Position {
  GOL // Goleiro
  ZAG // Zagueiro
  LAT // Lateral
  MEI // Meio-campo
  ATA // Atacante
}

model User {
  id                  String     @id @default(cuid())
  name                String?
  email               String     @unique
  emailVerified       DateTime?
  image               String?
  nickname            String?
  phone               String?
  primaryPosition     Position?
  secondaryPositions  Position[]
  /// Até quando o usuário já viu as notificações (RF48).
  notificationsSeenAt DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
}

// ---- Patotas (ciclo 2) ----

enum Role {
  ORGANIZER
  CO_ORGANIZER
  PLAYER
}

enum MemberType {
  MENSALISTA
  DIARISTA
}

enum MembershipStatus {
  ACTIVE
  /// Pediu para entrar e aguarda aprovação de um organizador (RF10).
  PENDING
}

model Patota {
  id          String   @id @default(cuid())
  name        String
  description String?
  location    String?
  /// Código usado no link de convite (/convite/<codigo>).
  inviteCode  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Padrões do jogo recorrente (RF16): usados para sugerir o próximo jogo.
  /// Dia da semana: 0 = domingo … 6 = sábado.
  defaultWeekday       Int?
  /// Horário no formato HH:MM (horário de Brasília).
  defaultTime          String?
  defaultMaxPlayers    Int     @default(14)
  defaultTeamsCount    Int     @default(2)
  /// Quantas horas antes do jogo a confirmação fecha.
  defaultDeadlineHours Int     @default(3)
  /// Prioridade dos mensalistas (RF19): diaristas só ocupam vagas X horas antes do jogo.
  /// null = diaristas podem confirmar desde o início.
  diaristaWindowHours  Int?
  /// RF10: quem entra pelo link precisa ser aprovado por um organizador.
  requireApproval      Boolean @default(false)

  // Financeiro (ciclo 6). Valores em centavos.
  billingMode      BillingMode @default(FIXED_MONTHLY)
  monthlyFeeCents  Int         @default(0)
  dropInFeeCents   Int         @default(0)
  /// Custo de cada jogo, dividido entre os confirmados no modo rateio.
  gameCostCents    Int         @default(0)
  /// Custo fixo mensal (ex.: aluguel), usado para sugerir a mensalidade (RN09).
  monthlyCostCents Int         @default(0)
  pixKey           String?
  /// Goleiros não pagam (RF44).
  keeperExempt     Boolean     @default(false)

  memberships   Membership[]
  games         Game[]
  charges       Charge[]
  expenses      Expense[]
  announcements Announcement[]
  activities    Activity[]
}

// ---- Financeiro (ciclo 6) ----

enum BillingMode {
  FIXED_MONTHLY
  SPLIT_PER_GAME
}

enum ChargeStatus {
  PENDING
  REPORTED
  PAID
  WAIVED
}

/// Valor que um integrante deve: mensalidade (competence) ou jogo (gameId).
model Charge {
  id           String       @id @default(cuid())
  patotaId     String
  membershipId String
  description  String
  amountCents  Int
  /// Mês de referência "AAAA-MM" para mensalidades.
  competence   String?
  gameId       String?
  status       ChargeStatus @default(PENDING)
  reportedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime     @default(now())

  patota     Patota     @relation(fields: [patotaId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  game       Game?      @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@unique([membershipId, competence])
  @@unique([membershipId, gameId])
  @@index([patotaId, status])
}

/// Saída de dinheiro do caixa (aluguel, bola, coletes…) (RF38).
model Expense {
  id          String   @id @default(cuid())
  patotaId    String
  description String
  amountCents Int
  date        DateTime
  createdAt   DateTime @default(now())

  patota Patota @relation(fields: [patotaId], references: [id], onDelete: Cascade)

  @@index([patotaId, date])
}

/// Vínculo de uma pessoa com uma patota. Papel, tipo e nota são por patota.
/// Convidados sem conta (RF13) têm userId nulo e usam guestName/guestPosition.
model Membership {
  id            String           @id @default(cuid())
  patotaId      String
  userId        String?
  role          Role             @default(PLAYER)
  type          MemberType       @default(MENSALISTA)
  /// Nota de 1 a 5 usada no sorteio (RF26). Visível só para organizadores (RF27).
  rating        Int              @default(3)
  status        MembershipStatus @default(ACTIVE)
  guestName     String?
  guestPosition Position?
  createdAt     DateTime         @default(now())

  patota        Patota                 @relation(fields: [patotaId], references: [id], onDelete: Cascade)
  user          User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendances   Attendance[]
  charges       Charge[]
  announcements Announcement[]         @relation("AnnouncementAuthor")
  reactions     AnnouncementReaction[]
  gameComments  GameComment[]          @relation("GameCommentAuthor")
  activities    Activity[]             @relation("ActivityActor")

  @@unique([patotaId, userId])
  @@index([userId])
}

// ---- Jogos e presença (ciclo 3) ----

enum GameStatus {
  SCHEDULED
  CANCELLED
}

enum AttendanceStatus {
  CONFIRMED
  MAYBE
  DECLINED
  WAITLIST
}

model Game {
  id                   String     @id @default(cuid())
  patotaId             String
  startsAt             DateTime
  location             String?
  maxPlayers           Int
  teamsCount           Int        @default(2)
  /// A partir de quando diaristas podem ocupar vagas (null = desde o início).
  diaristasOpenAt      DateTime?
  /// Depois deste momento só organizadores alteram a lista (RN03).
  confirmationDeadline DateTime
  status               GameStatus @default(SCHEDULED)
  notes                String?
  /// Resultado do sorteio: { teams: [{ members: [{ membershipId, role }] }], warnings } (RF29).
  draw                 Json?
  /// Enquanto nulo, só organizadores veem os times (RF35).
  drawPublishedAt      DateTime?
  /// Placar de cada time, na ordem do sorteio (RF52).
  teamScores           Int[]      @default([])
  /// Quando o organizador registrou presença real e placar. Depois disso o rateio usa quem foi.
  resultSavedAt        DateTime?
  createdAt            DateTime   @default(now())

  patota      Patota        @relation(fields: [patotaId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  charges     Charge[]
  comments    GameComment[]

  @@index([patotaId, startsAt])
}

model Attendance {
  id              String           @id @default(cuid())
  gameId          String
  membershipId    String
  status          AttendanceStatus
  /// Momento da última mudança de status — define a ordem da lista de espera.
  statusChangedAt DateTime         @default(now())
  /// Presença real marcada pelo organizador depois do jogo (RF52). null = não marcada.
  attended        Boolean?
  goals           Int              @default(0)

  game       Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([gameId, membershipId])
}

// ---- Modelos do Auth.js (@auth/prisma-adapter) ----

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---- Comunicação e percepção (ciclo 7) ----

/// Aviso no mural da patota (RF46).
model Announcement {
  id        String   @id @default(cuid())
  patotaId  String
  authorId  String?
  text      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  patota    Patota                 @relation(fields: [patotaId], references: [id], onDelete: Cascade)
  author    Membership?            @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reactions AnnouncementReaction[]

  @@index([patotaId, createdAt])
}

model AnnouncementReaction {
  announcementId String
  membershipId   String
  emoji          String

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([announcementId, membershipId, emoji])
}

/// Comentário no jogo, ex.: "vou atrasar 10 min" (RF47).
model GameComment {
  id        String   @id @default(cuid())
  gameId    String
  authorId  String?
  text      String
  createdAt DateTime @default(now())

  game   Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  author Membership? @relation("GameCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([gameId, createdAt])
}

enum Audience {
  ALL
  MANAGERS
}

/// Linha do tempo da patota e base das notificações no app (RF48, RF49).
model Activity {
  id        String   @id @default(cuid())
  patotaId  String
  actorId   String?
  message   String
  href      String?
  /// Pagamentos só aparecem para organizadores.
  audience  Audience @default(ALL)
  createdAt DateTime @default(now())

  patota Patota      @relation(fields: [patotaId], references: [id], onDelete: Cascade)
  actor  Membership? @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([patotaId, createdAt])
}
