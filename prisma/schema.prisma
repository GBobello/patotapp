// Schema do PatotApp.
// Ciclo 1: usuários, autenticação (modelos exigidos pelo Auth.js) e perfil do jogador.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Posições usadas no sorteio de times (RF25).
enum Position {
  GOL // Goleiro
  ZAG // Zagueiro
  LAT // Lateral
  MEI // Meio-campo
  ATA // Atacante
}

model User {
  id                 String     @id @default(cuid())
  name               String?
  email              String     @unique
  emailVerified      DateTime?
  image              String?
  nickname           String?
  phone              String?
  primaryPosition    Position?
  secondaryPositions Position[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
}

// ---- Patotas (ciclo 2) ----

enum Role {
  ORGANIZER
  CO_ORGANIZER
  PLAYER
}

enum MemberType {
  MENSALISTA
  DIARISTA
}

model Patota {
  id          String   @id @default(cuid())
  name        String
  description String?
  location    String?
  /// Código usado no link de convite (/convite/<codigo>).
  inviteCode  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]
}

/// Vínculo de uma pessoa com uma patota. Papel e tipo são por patota.
model Membership {
  id        String     @id @default(cuid())
  patotaId  String
  userId    String
  role      Role       @default(PLAYER)
  type      MemberType @default(MENSALISTA)
  createdAt DateTime   @default(now())

  patota Patota @relation(fields: [patotaId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([patotaId, userId])
  @@index([userId])
}

// ---- Modelos do Auth.js (@auth/prisma-adapter) ----

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}
