# Banco de dados (local: docker compose up -d)
DATABASE_URL="postgresql://patotapp:patotapp@localhost:5433/patotapp"

# Auth.js — gere com: npx auth secret
AUTH_SECRET=""

# Login com Google (opcional). Crie em https://console.cloud.google.com/apis/credentials
# URI de redirecionamento: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Envio do link mágico por e-mail (https://resend.com). Sem chave, o link aparece no terminal.
AUTH_RESEND_KEY=""
EMAIL_FROM="PatotApp <onboarding@resend.dev>"

# Notificações push do PWA (RF48). Gere as chaves com: npx web-push generate-vapid-keys
# Sem as duas chaves, o push fica desligado e as notificações continuam só no app.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contato do responsável pelo app, exigido pelos serviços de push.
VAPID_SUBJECT="mailto:contato@patotapp.app"

# Lembrete por e-mail antes do prazo de confirmação (RF48). Um agendador deve chamar
# GET /api/cron/lembretes a cada hora com o cabeçalho "Authorization: Bearer <CRON_SECRET>".
# Gere com: openssl rand -hex 32. Sem valor, a rota fica desativada.
CRON_SECRET=""
